<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="root" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: f7fafc;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkaly.desktop.controllers.InversionesCarteraController">
   <children>
      <HBox fx:id="navButtons" alignment="CENTER_LEFT" prefHeight="81.0" prefWidth="800.0" spacing="10.0" style="-fx-background-color: ffffff; -fx-border-color: e2e8f0; -fx-border-width: 0 0 1 0;">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Cartera">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#mostrarGeneral" text="General" />
            <Button mnemonicParsing="false" onAction="#mostrarOrdenes" text="Mercado" />
            <Button mnemonicParsing="false" onAction="#mostrarHistorial" text="Historial" />
            <Button mnemonicParsing="false" onAction="#mostrarAlertas" text="Alertas" />
         </children>
      </HBox>
      <HBox fx:id="contenidoPrincipal" spacing="16.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="16.0" />
         </padding>
         <children>
            <VBox fx:id="panelGrafica" prefHeight="200.0" prefWidth="100.0" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);" HBox.hgrow="ALWAYS">
               <children>
                  <HBox prefHeight="20.0" prefWidth="420.0">
                     <children>
                        <Label text="Mi Cartera" />
                        <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="selectorTipoCartera" prefWidth="150.0" promptText="Tipo" />
                     </children>
                  </HBox>
                  <HBox alignment="BASELINE_LEFT" prefHeight="29.0" prefWidth="420.0" spacing="14.0">
                     <children>
                        <Label fx:id="lblValorCartera" text="Valor" />
                        <Label fx:id="lblCambioCartera" text="Cambio" />
                     </children>
                  </HBox>
                  <HBox fx:id="filtrosPeriodo" alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="8.0" />
               </children>
               <padding>
                  <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
               </padding>
            </VBox>
            <VBox fx:id="panelPosiciones" maxWidth="360.0" minWidth="300.0" prefHeight="200.0" prefWidth="320.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
               <padding>
                  <Insets bottom="20.0" left="16.0" right="16.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Mis posiciones" />
                  <Separator prefWidth="200.0" style="-fx-background-color: e2e8f0;" />
                  <ScrollPane fx:id="scrollPosiciones" fitToWidth="true" prefHeight="200.0" prefWidth="200.0" style="-fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                     <content>
                        <VBox fx:id="listaPosiciones" prefHeight="200.0" prefWidth="100.0" spacing="10.0" />
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
