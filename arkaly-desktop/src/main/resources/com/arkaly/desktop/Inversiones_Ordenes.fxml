<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="575.0" minWidth="800.0" style="-fx-background-color: f7fafc;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkaly.desktop.controllers.InversionesMercadoController">
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="ALWAYS" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="contenido" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" spacing="20.0">
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefHeight="77.0" prefWidth="738.0" style="-fx-background-color: ffffff; -fx-border-color: e2e8f0; -fx-border-width: 0 0 1 0;">
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="81.0" prefWidth="800.0" spacing="10.0" style="-fx-background-color: ffffff; -fx-border-color: e2e8f0; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Mercado">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Region prefHeight="50.0" prefWidth="34.0" HBox.hgrow="ALWAYS" />
            <TextField fx:id="campoBusqueda" prefWidth="400.0" promptText="Buscador activo..." />
            <Button mnemonicParsing="false" onAction="#mostrarCartera" text="Cartera" />
            <Button mnemonicParsing="false" onAction="#mostrarGeneral" text="General" />
            <Button mnemonicParsing="false" onAction="#mostrarHistorial" text="Historial" />
            <Button mnemonicParsing="false" onAction="#mostrarAlertas" text="Alertas" />
         </children>
      </HBox>
   </top>
</BorderPane>
