<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="0.0" minWidth="0.0" style="-fx-background-color: #f7fafc;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkaly.desktop.controllers.GestorCarpetasController">
   <center>
      <StackPane fx:id="vistaContainer" prefHeight="531.0" prefWidth="1085.0" style="-fx-background-color: #f7fafc;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <ScrollPane fx:id="scrollCuadricula" fitToWidth="true" prefHeight="521.0" prefWidth="956.0" style="-fx-background-color: transparent;">
               <content>
                  <FlowPane fx:id="flowPane" hgap="15.0" prefHeight="497.0" prefWidth="954.0" vgap="15.0" />
               </content>
            </ScrollPane>
            <ListView fx:id="listaView" prefHeight="200.0" prefWidth="200.0" visible="false" />
         </children>
      </StackPane>
   </center>
   <top>
      <VBox prefHeight="157.0" prefWidth="1085.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="101.0" prefWidth="996.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 1;">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <Button fx:id="btnAtras" mnemonicParsing="false" onAction="#navegarAtras" style="-fx-background-color: #e2e8f0; -fx-background-radius: 6px; -fx-padding: 6 12 6;" text="←" />
                  <Label fx:id="rutaLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Mis Carpetas" />
                  <Region prefHeight="69.0" prefWidth="3.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnSubirDocumento" mnemonicParsing="false" onAction="#subirDocumento" style="-fx-background-color: #4ABD76; -fx-text-fill: white; -fx-background-radius: 6px; -fx-padding: 8 16 6 16; -fx-font-weight: bold;" text="+ Documento" />
                  <Button mnemonicParsing="false" onAction="#crearCarpeta" style="-fx-background-color: #4ABD76; -fx-text-fill: white; -fx-background-radius: 6px; -fx-padding: 8 16 6 16; -fx-font-weight: bold;" text="+ Carpeta" />
                  <Button mnemonicParsing="false" onAction="#crearEtiqueta" style="-fx-background-color: #4ABD76; -fx-text-fill: white; -fx-background-radius: 6px; -fx-padding: 8 16 6 16; -fx-font-weight: bold;" text="+ Etiqueta" />
                  <ToggleButton fx:id="toggleVista" mnemonicParsing="false" onAction="#cambiarVista" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-background-radius: 6px; -fx-padding: 6 12 6 12; -fx-font-size: 20; -fx-font-weight: bold;" text="⊞" />
               </children>
            </HBox>
            <HBox prefHeight="54.0" prefWidth="1085.0" spacing="10.0" style="-fx-background-color: ffffff; -fx-border-color: e2e8f0; -fx-border-width: 0 0 1 0;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <TextField fx:id="campoBusqueda" onAction="#aplicarFiltros" onKeyReleased="#aplicarFiltros" prefWidth="200.0" promptText="Buscar por nombre..." />
                  <ToggleButton fx:id="toggleBusquedaGlobal" mnemonicParsing="false" onAction="#cambiarModoBusqueda" style="-fx-background-color: e2e8f0; -fx-background-radius: 6px; -fx-padding: 6 12 6 12;" text="📁 Carpeta" />
                  <ComboBox fx:id="filtroTipo" onAction="#aplicarFiltros" promptText="Tipo" style="-fx-background-color: e2e8f0; -fx-background-radius: 6px; -fx-padding: 2 5 2 5;" />
                  <ComboBox fx:id="filtroEtiqueta" onAction="#aplicarFiltros" promptText="Etiqueta" style="-fx-background-color: e2e8f0; -fx-background-radius: 6px; -fx-padding: 2 5 2 5;" />
                  <ToggleButton fx:id="filtroTodos" mnemonicParsing="false" onAction="#aplicarFiltros" selected="true" style="-fx-background-color: e2e8f0; -fx-background-radius: 6px; -fx-padding: 6 12 6 12;" text="Todos" />
                  <ToggleButton fx:id="filtroCarpetas" mnemonicParsing="false" onAction="#aplicarFiltros" style="-fx-background-color: e2e8f0; -fx-background-radius: 6px; -fx-padding: 6 12 6 12;" text="Carpetas" />
                  <ToggleButton fx:id="filtroDocumentos" mnemonicParsing="false" onAction="#aplicarFiltros" style="-fx-background-color: e2e8f0; -fx-background-radius: 6px; -fx-padding: 6 12 6 12;" text="Documentos" />
                  <Button mnemonicParsing="false" onAction="#limpiarFiltros" style="-fx-background-color: e2e8f0; -fx-background-radius: 6px; -fx-padding: 6 12 6 12;" text="Limpiar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
</BorderPane>
