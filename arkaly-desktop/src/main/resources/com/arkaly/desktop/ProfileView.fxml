<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.arkaly.desktop.controllers.ProfileController"
            prefHeight="400.0" prefWidth="300.0">
    <children>
        <VBox layoutX="50.0" layoutY="50.0" spacing="15.0" prefWidth="200.0">
            <children>
                <Label text="Mi Perfil">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>
                <Label text="Nombre:" textFill="#a1a0a0"/>
                <Label fx:id="nombreLabel"/>
                <Label text="ID de usuario:" textFill="#a1a0a0"/>
                <Label fx:id="idLabel"/>
                <Button mnemonicParsing="false" onAction="#pulsarCerrarSesion"
                        prefWidth="200.0" prefHeight="36.0"
                        text="Cerrar sesión" style="-fx-text-fill: red;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>