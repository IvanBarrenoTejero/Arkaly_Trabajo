<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="575.0" minWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkaly.desktop.controllers.InversionesGeneralController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <HBox fx:id="navButtons" alignment="CENTER_LEFT" prefHeight="81.0" prefWidth="800.0" spacing="10.0" style="-fx-background-color: ffffff; -fx-border-color: e2e8f0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="General">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#mostrarCartera" text="Cartera" />
                        <Button mnemonicParsing="false" onAction="#mostrarOrdenes" text="Mercado" />
                        <Button mnemonicParsing="false" onAction="#mostrarHistorial" text="Historial" />
                        <Button mnemonicParsing="false" onAction="#mostrarAlertas" text="Alertas" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="contenidoInversiones" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: f7fafc;" BorderPane.alignment="CENTER">
            <children>
                <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent;">
                    <content>
                        <VBox fx:id="contenido" prefHeight="200.0" prefWidth="100.0" spacing="20.0" style="-fx-background-color: ffffff; -fx-border-color: e2e8f0; -fx-border-width: 0 0 1 0;">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <VBox fx:id="tarjetaTotal" prefHeight="101.0" prefWidth="758.0" spacing="5.0" style="-fx-background-color: linear-gradient(to right, #2d3748, #4a5568); -fx-background-radius: 16px;">
                                    <children>
                                        <ComboBox fx:id="selectorTipo" prefWidth="160.0" promptText="Todo" style="-fx-background-color: e2e8f0; -fx-background-radius: 6px; -fx-padding: 1 1 1 1;" />
                                        <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" spacing="8.0">
                                            <children>
                                                <Label fx:id="labelTotal" style="-fx-text-fill: d3748;" text="0.00€" textFill="#fffefe">
                                                    <font>
                                                        <Font name="System Bold" size="24.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="labelPorcentaje" text="12%" textFill="WHITE">
                                                    <font>
                                                        <Font name="System Bold" size="18.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                            <padding>
                                                <Insets bottom="2.0" left="8.0" right="8.0" top="2.0" />
                                            </padding>
                                        </HBox>
                                    </children>
                                    <padding>
                                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                                    </padding>
                                </VBox>
                                <VBox fx:id="contenedorFavoritos" prefHeight="211.0" prefWidth="758.0" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <children>
                                        <Label style="-fx-font-weight: bold;" text="⭐ Siguiendo">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <VBox fx:id="contenedorAlertas" minHeight="310.0" prefHeight="310.0" prefWidth="758.0" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3);">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <children>
                                        <Label style="-fx-font-weight: bold;" text="🔔 Mis alertas de precio">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </StackPane>
    </center>
</BorderPane>
