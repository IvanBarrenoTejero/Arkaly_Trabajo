<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="423.0" prefWidth="754.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkaly.desktop.controllers.TransaccionesController">
   <center>
      <VBox prefHeight="538.0" prefWidth="754.0" spacing="12.0" style="-fx-background-color: ffffff; -fx-background-radius: 12px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3); -fx-border-color: e2e8f0; -fx-border-radius: 12px; -fx-border-width: 1;" BorderPane.alignment="CENTER">
         <children>
             <HBox prefHeight="29.0" prefWidth="253.0" spacing="10.0">
                 <children>
                     <Label style="-fx-text-fill: 2d3748;" text="Transacciones">
                         <font><Font name="System Bold" size="16.0" /></font>
                     </Label>
                     <Region prefHeight="26.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
                     <Button mnemonicParsing="false" onAction="#abrirGestionCategorias" style="-fx-background-color: #718096; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 6 14 6 14;" text="⚙ Categorías" />
                     <Button mnemonicParsing="false" onAction="#abrirNuevaTransaccion" style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 6 14 6 14;" text="+ Nueva" />
                 </children>
             </HBox>
            <TableView fx:id="tablaTransacciones" prefHeight="300.0">
               <columns>
                  <TableColumn fx:id="colTxFecha" prefWidth="100.0" text="Fecha" />
                  <TableColumn fx:id="colTxCategoria" prefWidth="130.0" text="Categoria" />
                  <TableColumn fx:id="colTxTipo" text="Tipo" />
                  <TableColumn fx:id="colTxCantidad" prefWidth="100.0" text="Cantidad" />
                  <TableColumn fx:id="colTxDescripcion" prefWidth="200.0" text="Descripcion" />
                  <TableColumn fx:id="colTxAcciones" prefWidth="100.0" />
               </columns>
            </TableView>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
