<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="575.0" minWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.arkaly.desktop.controllers.InversionesHistorialController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="81.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="Historial">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Region prefHeight="50.0" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="selectorTipoHistorial" prefWidth="160.0" style="-fx-background-color: #edf2f7; -fx-background-radius: 6px;" />
                        <Button mnemonicParsing="false" onAction="#mostrarGeneral" text="General" />
                        <Button mnemonicParsing="false" onAction="#mostrarCartera" text="Cartera" />
                        <Button mnemonicParsing="false" onAction="#mostrarOrdenes" text="Mercado" />
                        <Button mnemonicParsing="false" onAction="#mostrarAlertas" text="Alertas" />
                    </children>
                </HBox>
                <Label fx:id="lblResumenTotal" style="-fx-font-size: 12px; -fx-text-fill: #4a5568; -fx-background-color: #edf2f7; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                    </padding>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="listaOperaciones" spacing="10.0" style="-fx-background-color: #f7fafc;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
